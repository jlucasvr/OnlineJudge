POSTGRES_PASSWORD=change-me
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=change-this-dev-jwt-secret-with-at-least-32-chars
OJ_BOOTSTRAP_WORKER_PASSWORD=change-this-worker-password
WORKER_API_PASSWORD=change-this-worker-password
WORKER_API_USERNAME=worker

# Use um caminho absoluto do host para que API, Worker e containers de sandbox
# enxerguem os mesmos artefatos. Exemplo Linux: /opt/onlinejudge/data
OJ_HOST_DATA_ROOT=/tmp/onlinejudge-data
OJ_DOCKER_HOST_DATA_ROOT=/tmp/onlinejudge-data

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=
